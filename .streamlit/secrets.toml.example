# Hugging Face Private Model Repository Configuration
# Copy this file to .streamlit/secrets.toml for Streamlit Community Cloud or local testing.
# NEVER commit .streamlit/secrets.toml with your real access token!

# Exact repository identifier for the fine-tuned SetFit agricultural model
HF_MODEL_REPO_ID = "BHARGAVAREDDY1/elnino-agri-setfit"

# Exact immutable commit revision (do not use 'main' in production)
HF_MODEL_REVISION = "0a50cfd0b1e2e6fcf9e2cd3a3bafcaecbd5fd0f0"

# Secret Hugging Face User Access Token (Read permission required)
# Replace placeholder with your actual Hugging Face read token
HF_TOKEN = "hf_your_read_access_token_placeholder"
